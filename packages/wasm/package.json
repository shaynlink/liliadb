{
  "name": "@liliadb/wasm",
  "version": "0.2.0-alpha.1",
  "description": "Local-first multimodel database in WebAssembly: the browser's origin private file system (OPFS) or memory",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "pkg",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./pkg/*": "./pkg/*"
  },
  "scripts": {
    "build:wasm": "bash ../../tools/wasm/build.sh",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test 'dist/**/*.test.js'",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "package": "pnpm pack --pack-destination ../../dist"
  },
  "dependencies": {
    "@liliadb/client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
