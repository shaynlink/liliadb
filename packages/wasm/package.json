{
  "name": "@liliadb/wasm",
  "version": "0.1.0-alpha.6",
  "description": "Local-first multimodel database for WebAssembly, browsers (OPFS), and Edge runtimes",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./pkg/*": "./pkg/*"
  },
  "files": [
    "dist",
    "pkg",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/tests/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "6.0.2"
  }
}
