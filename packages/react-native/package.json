{
  "name": "@liliadb/react-native",
  "version": "0.2.0-alpha.1",
  "description": "Local-first multimodel database (KV, JSON, graph, full-text, vector, time series, geo, CRDT, SQL) for React Native, through JSI",
  "keywords": [
    "database",
    "expo",
    "full-text-search",
    "graph",
    "jsi",
    "json",
    "key-value",
    "local-first",
    "offline-first",
    "react-native",
    "sql",
    "vector"
  ],
  "license": "Apache-2.0",
  "author": "LiliaDB Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/shaynlink/lilia.git",
    "directory": "packages/react-native"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "cpp",
    "ios",
    "android",
    "!android/build",
    "!android/.gradle",
    "LiliaReactNative.podspec"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --import ./tests/register.js --test 'dist/**/*.test.js'",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@liliadb/client": "workspace:*"
  },
  "devDependencies": {
    "@liliadb/node": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-test-renderer": "19.3.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.76.0"
  },
  "codegenConfig": {
    "name": "LiliaReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.liliadb.reactnative"
    }
  }
}
