{
  "name": "@liliadb/node",
  "version": "0.1.0-alpha.9",
  "description": "Local-first multimodel database for Node.js",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "test:bun": "bun test tests/compat-bun.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "package": "pnpm pack --pack-destination ../../dist"
  },
  "optionalDependencies": {
    "@liliadb/node-darwin-arm64": "workspace:*",
    "@liliadb/node-darwin-x64": "workspace:*",
    "@liliadb/node-linux-arm64-gnu": "workspace:*",
    "@liliadb/node-linux-x64-gnu": "workspace:*",
    "@liliadb/node-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "msgpackr": "2.1.4"
  }
}
