#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref.
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git merge-base "$local_sha" main 2>/dev/null || true)"
    [ -n "$base" ] || continue
  else
    base="$remote_sha"
  fi
  git rev-parse --verify --quiet "${base}^{commit}" >/dev/null || continue
  "$root/tools/check-file-size.sh" range "$base" "$local_sha"
done
