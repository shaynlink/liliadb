    "expected": [
      { "version": "$kv_a2", "deleted": false },
      { "version": "$doc_a2", "deleted": false }
    ]
  },
  {
    "name": "rollback on stale JSON version",
    "op": "batch",
    "operations": [
      { "model": "kv_set", "namespace": "cache", "key": [97], "value": [99] },
