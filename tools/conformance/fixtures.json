[
  { "name": "missing KV", "op": "kv_get", "namespace": "cache", "key": [97], "expected": null },
  { "name": "missing JSON", "op": "json_get", "space": "docs", "id": "a", "expected": null },
  {
    "name": "atomic multimodel create",
    "op": "batch",
    "operations": [
      {
        "model": "kv_set",
        "namespace": "cache",
        "key": [97],
        "value": [0, 128, 255],
        "if_version": 0
      },
      {
        "model": "json_put",
        "space": "docs",
        "id": "a",
        "value": { "nested": [null, true, 3.5, "é"] },
        "if_version": 0
      }
    ],
    "expected": [
      { "version": "$kv_a1", "deleted": false },
